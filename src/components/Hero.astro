---
import { Image } from 'astro:assets';
import { site } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__meta label">Edinburgh <span>·</span> Dog grooming <span>·</span> By appointment</div>
  <div class="hero__yellow-block" aria-hidden="true"></div>
  <div class="hero__issue label" aria-hidden="true">Issue No. 01<br />Fresh cuts / 2026</div>

  <h1 class="hero__title" id="hero-title">
    <span class="hero__word hero__word--glamour">Doggie</span>
    <span class="hero__word hero__word--pooch">Style</span>
    <span class="sr-only">— {site.business.tagline}</span>
  </h1>

  <div class="hero__dog-wrap" data-reveal>
    <div class="hero__dog-backdrop" aria-hidden="true"></div>
    <Image
      class="hero__dog"
      src={site.images.hero.src}
      alt={site.images.hero.alt}
      widths={[480, 720, 960]}
      sizes="(max-width: 700px) 82vw, 42vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
    <span class="hero__sticker" aria-hidden="true">Fresh<br />look!</span>
  </div>

  <div class="hero__intro" data-reveal>
    <p class="eyebrow">Independent Edinburgh studio</p>
    <p>{site.business.description}</p>
  </div>

  <div class="hero__tagline" data-reveal>
    <p>Good dogs.<br /><em>Great hair.</em></p>
  </div>

  <a class="hero__book" href={site.business.bookingHref} aria-label="Book a groom with Doggie Style">
    <span>Book a<br />groom</span><b aria-hidden="true">↘</b>
  </a>
</section>
