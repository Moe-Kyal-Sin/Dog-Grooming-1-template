---
import { Image } from 'astro:assets';
import { site } from '../data/site';
const member = site.team[0];
---

<section class="about section" id="about" aria-labelledby="about-title">
  <div class="about__portrait" data-reveal>
    <Image
      src={member.image}
      alt={member.imageAlt}
      widths={[500, 760, 1040]}
      sizes="(max-width: 760px) 88vw, 48vw"
      format="webp"
      loading="lazy"
    />
    <span class="about__portrait-label label">Portrait placeholder / replace me</span>
  </div>
  <div class="about__copy" data-reveal>
    <p class="section-kicker label">Behind the scissors / 05</p>
    <h2 id="about-title">Meet your<br /><em>dog’s stylist.</em></h2>
    <p class="about__name">{member.name} <span>{member.role}</span></p>
    <p>{member.bio}</p>
    <a class="text-link" href={site.business.instagramHref}>Say hello on Instagram <span aria-hidden="true">↗</span></a>
  </div>
</section>
