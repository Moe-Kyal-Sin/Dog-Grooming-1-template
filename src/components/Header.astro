---
import { site } from '../data/site';
---

<header class="site-header" data-header>
  <a class="wordmark" href="#top" aria-label={`${site.business.name}, home`}>
    <span>Glamour</span><span>Pooch</span>
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    <span class="menu-toggle__label">Menu</span>
    <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
  </button>

  <nav class="site-nav" id="site-nav" aria-label="Main navigation">
    <ul>
      {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
    <a class="button button--dark nav-book" href={site.business.bookingHref}>{site.ctas.primary}<span aria-hidden="true">↗</span></a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('.site-nav');

  function closeMenu() {
    toggle?.setAttribute('aria-expanded', 'false');
    header?.classList.remove('menu-open');
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('menu-open', !open);
  });

  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu();
      toggle?.focus();
    }
  });
</script>
